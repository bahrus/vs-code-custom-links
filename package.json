{
  "name": "custom-link-attributes",
  "displayName": "Custom Link Attributes",
  "description": "Make custom HTML attributes behave like hyperlinks",
  "version": "0.0.9",
  "icon": "images/icon.png",
  "engines": {
    "vscode": "^1.60.0"
  },
  "publisher": "andersonbruceb",
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onLanguage:html"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bahrus/vs-code-custom-links.git"
  },
  "main": "./out/extension.js",
  "contributes": {
    "configuration": {
      "title": "Custom Link Attributes",
      "properties": {
        "customLinkAttributes.attributes": {
          "type": "array",
          "default": [],
          "description": "List of custom HTML attributes to treat as links",
          "items": {
            "type": "string"
          }
        }
      }
    }
  },
  "dependencies": {
    "node-html-parser": "8.0.4"
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "update": "ncu -u && npm install",
    "deploy": "vsce publish"
  },
  "devDependencies": {
    "@types/vscode": "^1.60.0",
    "@types/node": "^26.x",
    "typescript": "^6.0.3"
  }
}
